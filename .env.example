# Copy to .env (git-ignored). Never commit real values.

# --- read by docker compose --------------------------------------------------
N8N_PORT=5678
GENERIC_TIMEZONE=Europe/Paris
# Optional. Leave empty and n8n generates one inside the data volume.
N8N_ENCRYPTION_KEY=

# --- read by the scripts (export them in your shell, compose ignores them) ----
# Local n8n owner account, created by scripts/bootstrap.py on a fresh instance.
N8N_OWNER_EMAIL=you@example.com
N8N_OWNER_PASSWORD=
# Optional: an existing n8n API key instead of owner login.
N8N_API_KEY=

# Live mode only: used once by bootstrap.py to create the "OpenAI account" credential.
OPENAI_API_KEY=
# Optional: any OpenAI-compatible endpoint (gateway, proxy, local server).
OPENAI_BASE_URL=
